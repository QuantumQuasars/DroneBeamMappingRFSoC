cac03091d772"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Pin", " ", 
      FractionBox[
       SuperscriptBox["\[Lambda]", "2"], 
       RowBox[{"4", " ", "\[Pi]", " ", 
        SuperscriptBox["r", "2"]}]]}], "==", 
     RowBox[{
     "4", "\[Pi]", " ", "kb", " ", "T", " ", "\[CapitalDelta]\[Nu]"}]}], ",", 
