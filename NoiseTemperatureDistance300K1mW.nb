  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SqrtBox["Pin"], " ", "\[Lambda]"}], 
       RowBox[{"4", " ", 
        SqrtBox["kb"], " ", "\[Pi]", " ", 
        SqrtBox["T"], " ", 
        SqrtBox["\[CapitalDelta]\[Nu]"]}]]}]}], "}"}], ",", 
